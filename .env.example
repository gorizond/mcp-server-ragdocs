EMBEDDING_PROVIDER="ollama"
OLLAMA_BASE_URL="http://localhost:11434"
QDRANT_URL="http://localhost:6333"
#QDRANT_API_KEY=""
#OPENAI_API_KEY=""

# Custom embedding model (overrides default per provider)
# For Ollama: defaults to 'nomic-embed-text'
# For OpenAI: defaults to 'text-embedding-ada-002'
#EMBEDDING_MODEL="nomic-ai/nomic-embed-text-v1.5-GGUF"

# OpenAI-compatible base URL (e.g. LM Studio: http://localhost:1234/v1)
#OPENAI_BASE_URL="http://localhost:1234/v1"

# Explicit vector size for Qdrant collection (overrides provider defaults: openai=1536, ollama=768)
#VECTOR_SIZE="768"
